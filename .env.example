# переменные окружения для запуска (профиль dev)
# скопируй в .env, docker-compose подхватит его сам

# Подключение к PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/edu_platform
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Режим генерации схемы: update | validate | create | create-drop | none
DDL_AUTO=update

# Логирование SQL: DEBUG | INFO
SQL_LOG_LEVEL=INFO

# Предзаполнение демо-данными при старте: true | false
SEED_DATA=true

# Порт приложения (используется в docker-compose)
SERVER_PORT=8080
